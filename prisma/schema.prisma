generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  description     String       @db.Text
  longDescription String?      @db.Text
  category        String
  technologies    String       @db.Text
  features        String?      @db.Text
  challenges      String?      @db.Text
  results         String?      @db.Text
  liveUrl         String?
  githubUrl       String?
  coverImage      String?
  featured        Boolean      @default(false)
  order           Int          @default(0)
  published       Boolean      @default(true)
  screenshots     Screenshot[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Screenshot {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model App {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  iconUrl     String?
  published   Boolean        @default(true)
  pages       AppPage[]
  tickets     SupportTicket[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SupportTicket {
  id        String          @id @default(cuid())
  token     String          @unique @default(cuid())
  name      String
  email     String
  message   String          @db.Text
  status    String          @default("open")
  category  String          @default("general")
  app       App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId     String
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
}

model TicketMessage {
  id        String        @id @default(cuid())
  content   String        @db.Text
  imageUrl  String?       @db.Text
  fromAdmin Boolean       @default(false)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  createdAt DateTime      @default(now())
}

// ─── CRM ────────────────────────────────────────────────────────────────────

model CrmAccount {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  permissions String   @db.Text // JSON array of permission keys
  resources   String?  @db.Text // JSON: { apps: string[], support: string[] }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrmUser {
  id        String          @id @default(cuid())
  name      String
  email     String          @unique
  role      String          @default("employee") // admin | pm | lead | employee
  avatar    String?
  color     String          @default("#3b82f6")
  projects  ProjectMember[]
  tasks     CrmTask[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CrmProject {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  status      String          @default("planning") // planning | active | testing | done | frozen | cancelled
  priority    String          @default("medium")   // low | medium | high | critical
  deadline    DateTime?
  archived    Boolean         @default(false)
  members     ProjectMember[]
  tasks       CrmTask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id        String     @id @default(cuid())
  project   CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      CrmUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@unique([projectId, userId])
}

model CrmTask {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      String     @default("todo") // todo | in_progress | review | done
  priority    String     @default("medium")
  deadline    DateTime?
  order       Int        @default(0)
  project     CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  assignee    CrmUser?   @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─── Monitoring ─────────────────────────────────────────────────────────────

model MonitoredServer {
  id                 String          @id @default(cuid())
  name               String
  url                String
  token              String
  color              String          @default("#3b82f6")
  active             Boolean         @default(true)
  // Alert config
  alertTelegram      String?         // Telegram chat ID
  alertEmail         String?
  alertCpuThreshold  Int             @default(90)
  alertRamThreshold  Int             @default(90)
  alertDiskThreshold Int             @default(90)
  // Location for map
  lat                Float?
  lng                Float?
  country            String?
  // Checks
  sslDomain          String?         // domain for SSL cert check
  healthUrl          String?         // URL that should return 200
  // Relations
  metrics            ServerMetric[]
  incidents          ServerIncident[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ServerMetric {
  id           String          @id @default(cuid())
  server       MonitoredServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  online       Boolean
  cpuPercent   Float           @default(0)
  memPercent   Float           @default(0)
  diskPercent  Float           @default(0)
  responseMs   Int             @default(0)
  sslDaysLeft  Int?
  healthOk     Boolean?
  createdAt    DateTime        @default(now())

  @@index([serverId, createdAt])
}

model ServerIncident {
  id         String          @id @default(cuid())
  server     MonitoredServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId   String
  type       String          // offline | cpu | ram | disk | ssl | health
  message    String
  startedAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([serverId, startedAt])
}

model AppPage {
  id        String   @id @default(cuid())
  type      String   // 'privacy' | 'terms' | 'support'
  title     String
  content   String   @db.LongText
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, type])
}
