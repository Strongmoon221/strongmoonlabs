# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (generate a strong random string for production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Admin credentials (used for initial seed)
ADMIN_EMAIL="admin@strongmoonlabs.com"
ADMIN_PASSWORD="change-this-strong-password"

# SMTP Email (for contact form)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Contact recipient email
CONTACT_EMAIL="hello@strongmoonlabs.com"

# Site URL (for production)
NEXT_PUBLIC_SITE_URL="https://strongmoonlabs.com"
